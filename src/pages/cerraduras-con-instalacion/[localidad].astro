---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import FondoVivo from '../../components/FondoVivo.astro';
import ProductoCard from '../../components/ProductoCard.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { empresa, tel, whatsapp } from '../../data/empresa';
import { tiposCerradura, productos, rangoPrecios, pesos, fraseInstalacion } from '../../data/cerraduras';
import { localidadesBogota, type Localidad } from '../../data/localidades';
import { fotoTipo } from '../../data/fotos';
import { negocioLocal, migas } from '../../data/schema';

export function getStaticPaths() {
  return localidadesBogota.map((localidad, i) => ({ params: { localidad: localidad.slug }, props: { localidad, i } }));
}

const { localidad: l, i } = Astro.props as { localidad: Localidad; i: number };
const url = `${empresa.sitio}/cerraduras-con-instalacion/${l.slug}`;
const b = (n: number) => l.barrios[n % l.barrios.length];
const barrios = l.barrios.slice(0, -1).join(', ') + ' y ' + l.barrios[l.barrios.length - 1];
const vecinas = [-2, -1, 1, 2].map((d) => localidadesBogota[(i + d + localidadesBogota.length) % localidadesBogota.length]);

// Rota tipos, foto y productos para que cada localidad no repita la misma página.
const tiposBase = tiposCerradura.filter((t) => t.slug !== 'candados');
const tipos = [...tiposBase.slice(i % tiposBase.length), ...tiposBase.slice(0, i % tiposBase.length)];
const fotos = ['vitrina', 'sobreponer', 'cerrojos', 'embutir', 'manija-y-pomo'];
const foto = fotoTipo(fotos[i % fotos.length]);
const destacados = tipos.slice(0, 4).map((t) => productos.filter((p) => p.tipo === t.slug)[i % 3] ?? productos.find((p) => p.tipo === t.slug)).filter((p) => p !== undefined);

const casos = [
  { titulo: `Te mudaste en ${b(0)}`, texto: `Cerrojo o cerradura nueva para que nadie más tenga llave. Te la llevamos y te la dejamos instalada en ${b(0)} o ${b(1)}.` },
  { titulo: 'Puerta principal más segura', texto: `Cerraduras multipunto y de embutir para apartamentos y casas de ${b(2)} y ${b(3)}, con llaves difíciles de copiar.` },
  { titulo: 'Sin llaves', texto: `Cerraduras digitales con huella, clave o app para tu casa, apartamento u oficina en ${l.nombre}, configuradas en tu celular.` },
  { titulo: 'Locales y oficinas', texto: `Cerraduras eléctricas, de sobreponer y cajas fuertes para negocios en ${b(4)} y toda la localidad.` },
];

const preguntas = [
  { p: `¿Instalan cerraduras en ${l.nombre}?`, r: `Sí. Te llevamos la cerradura y te la dejamos instalada en todos los barrios de ${l.nombre}, entre ellos ${barrios}.` },
  { p: '¿Qué garantía tienen?', r: `${fraseInstalacion.garantia} Si algo falla, vamos y lo resolvemos.` },
  { p: '¿La instalación se cobra aparte?', r: 'Sí. Antes de ir te damos el valor total, cerradura más instalación, y no se cobra nada que no hayas aprobado.' },
  { p: '¿Cómo sé cuál sirve para mi puerta?', r: 'Mándanos una foto de la puerta y de la cerradura actual por WhatsApp y te decimos qué opciones encajan.' },
];

const schema = [
  negocioLocal(),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Cerraduras con instalación en ${l.nombre}, Bogotá`,
    serviceType: 'Venta e instalación de cerraduras',
    provider: { '@id': `${empresa.sitio}/#negocio` },
    areaServed: { '@type': 'AdministrativeArea', name: `${l.nombre}, Bogotá` },
    url,
  },
  migas([
    { nombre: 'Inicio', url: empresa.sitio },
    { nombre: 'Cerraduras con instalación', url: `${empresa.sitio}/cerraduras-con-instalacion` },
    { nombre: l.nombre, url },
  ]),
];
---
<Base
  title={`Cerraduras con instalación en ${l.nombre}, Bogotá | Cerraya`}
  description={`${fraseInstalacion.principal} ${fraseInstalacion.garantia} Cerraduras digitales, cerrojos y de sobreponer instaladas en ${b(0)}, ${b(1)}, ${b(2)} y todo ${l.nombre}.`}
  schema={schema}
>
  <section class="hero-ins con-fondo">
    <FondoVivo />
    <div class="container hero-grid">
      <div>
        <nav class="migas" aria-label="Ruta"><a href="/">Inicio</a><span>/</span><a href="/cerraduras-con-instalacion">Cerraduras con instalación</a><span>/</span><span aria-current="page">{l.nombre}</span></nav>
        <h1>Cerraduras con instalación en <span>{l.nombre}</span></h1>
        <p class="frase">{fraseInstalacion.principal} <span>{fraseInstalacion.garantia}</span></p>
        <div class="actions">
          <a class="btn btn-wa btn-lg" href={whatsapp(`Hola Cerraya, quiero una cerradura instalada en ${l.nombre}`)} target="_blank" rel="noopener"><Icon name="whatsapp" />Cotizar por WhatsApp</a>
          <a class="btn btn-accent btn-lg" href={tel}><Icon name="telefono" />Llamar · {empresa.telefonoVisible}</a>
        </div>
      </div>
      {foto && (
        <figure class="hero-foto">
          <Image src={foto} alt={`Cerraduras que instalamos en ${l.nombre}`} widths={[480, 800]} sizes="(max-width: 960px) 100vw, 40vw" loading="eager" />
        </figure>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Lo que más instalamos en {l.nombre}</h2>
      <div class="grid grid-2">
        {casos.map((c) => (
          <div class="card feature">
            <h3>{c.titulo}</h3>
            <p>{c.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-cream">
    <div class="container">
      <h2>Elige tu cerradura</h2>
      <ul class="tipos">
        {tipos.map((t) => <li><a href={`/cerraduras/${t.slug}`}><strong>{t.nombre}</strong><span>Producto desde {pesos(rangoPrecios(t).desde)}</span></a></li>)}
      </ul>
      <div class="productos">
        {destacados.map((p) => <ProductoCard producto={p!} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2 dos">
      <div>
        <h2>Barrios de {l.nombre}</h2>
        <ul class="chips">{l.barrios.map((x) => <li>{x}</li>)}</ul>
        <h3 class="vec-h">También en localidades cercanas</h3>
        <ul class="chips enlaces">
          {vecinas.map((v) => <li><a href={`/cerraduras-con-instalacion/${v.slug}`}>Cerraduras en {v.nombre}</a></li>)}
          <li><a href={`/cerrajero-en/${l.slug}`}>Cerrajero en {l.nombre}</a></li>
          <li><a href={`/camaras-de-seguridad/${l.slug}`}>Cámaras en {l.nombre}</a></li>
        </ul>
      </div>
      <div>
        <h2>Preguntas frecuentes</h2>
        <Faq preguntas={preguntas} />
      </div>
    </div>
  </section>

  <CtaFinal titulo={`¿Necesitas una cerradura en ${l.nombre}?`} texto="Mándanos una foto de tu puerta por WhatsApp y te recomendamos la cerradura, con el valor instalada." />
</Base>

<style>
  .hero-ins { background: linear-gradient(180deg, var(--green-800), var(--green-900)); color: var(--on-green); padding: 2rem 0 clamp(2.5rem, 6vw, 4rem); }
  .hero-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .hero-ins h1 { color: var(--cream); }
  .hero-ins h1 span { color: var(--accent); }
  .frase { margin: .5rem 0 0; max-width: 30ch; font-family: var(--display); font-weight: 800; font-size: clamp(1.3rem, 2.6vw, 1.85rem); line-height: 1.25; color: var(--cream); }
  .frase span { display: block; margin-top: .4rem; color: var(--accent); }
  .hero-ins .actions { margin-top: 1.75rem; }
  .hero-foto { margin: 0; }
  .hero-foto :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); box-shadow: var(--shadow); }
  .migas { display: flex; flex-wrap: wrap; gap: .5rem; font-size: .88rem; color: var(--on-green-muted); margin-bottom: 1.25rem; }
  .migas a { color: var(--cream); }
  .tipos { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: .6rem; }
  .tipos a { display: grid; gap: .15rem; padding: .8rem 1rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--white); text-decoration: none; height: 100%; }
  .tipos a:hover { border-color: var(--green-600); }
  .tipos strong { font-family: var(--display); font-size: .95rem; color: var(--ink); }
  .tipos span { font-size: .86rem; font-weight: 700; color: var(--green-600); }
  .productos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .dos { align-items: start; gap: 2.5rem; }
  .vec-h { font-size: 1.15rem; margin-top: 1.75rem; }
  .enlaces a { text-decoration: none; color: var(--green-800); font-weight: 600; }
  @media (max-width: 1080px) { .productos, .tipos { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 960px) { .hero-grid { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .productos, .tipos { grid-template-columns: repeat(2, 1fr); gap: .7rem; } }
</style>
