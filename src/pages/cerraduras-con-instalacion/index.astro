---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import FondoVivo from '../../components/FondoVivo.astro';
import ProductoCard from '../../components/ProductoCard.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { empresa, whatsapp } from '../../data/empresa';
import { tiposCerradura, productos, rangoPrecios, pesos, marcasDestacadas, fraseInstalacion } from '../../data/cerraduras';
import { localidadesBogota } from '../../data/localidades';
import { fotoTipo } from '../../data/fotos';
import { negocioLocal, migas } from '../../data/schema';

const url = `${empresa.sitio}/cerraduras-con-instalacion`;
const tipos = tiposCerradura.filter((t) => t.slug !== 'candados');
const fotoHero = fotoTipo('vitrina');
// Un producto por tipo para mostrar lo que se instala.
const destacados = tipos.map((t) => productos.find((p) => p.tipo === t.slug)).filter((p) => p !== undefined);

const preguntas = [
  { p: '¿La instalación tiene costo aparte?', r: 'Sí. El precio de cada cerradura es del producto. Antes de ir te damos el valor total, cerradura más instalación, y no se cobra nada que no hayas aprobado.' },
  { p: '¿Qué garantía tienen?', r: `${fraseInstalacion.garantia} Si algo falla, vamos y lo resolvemos.` },
  { p: '¿Puedo comprar la cerradura por mi cuenta y que ustedes la instalen?', r: 'Sí. Revisamos que sirva para tu puerta y la instalamos. Si nos la compras a nosotros, te llevamos la correcta para tu puerta y no tienes que ir a buscarla.' },
  { p: '¿Cómo sé qué cerradura sirve para mi puerta?', r: 'Mándanos una foto de la puerta y de la cerradura actual por WhatsApp y te recomendamos las opciones que encajan, con su precio.' },
  { p: '¿En qué zonas instalan?', r: `En las ${localidadesBogota.length} localidades de Bogotá.` },
];

const schema = [
  negocioLocal(),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Venta e instalación de cerraduras en Bogotá',
    serviceType: 'Cerraduras con instalación',
    provider: { '@id': `${empresa.sitio}/#negocio` },
    areaServed: { '@type': 'City', name: 'Bogotá' },
    url,
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Cerraduras con instalación',
      itemListElement: tipos.map((t) => ({ '@type': 'Offer', itemOffered: { '@type': 'Product', name: t.nombre, url: `${empresa.sitio}/cerraduras/${t.slug}` } })),
    },
  },
  migas([
    { nombre: 'Inicio', url: empresa.sitio },
    { nombre: 'Cerraduras con instalación', url },
  ]),
];
---
<Base
  title="Cerraduras con instalación en Bogotá: te la llevamos y te la dejamos instalada | Cerraya"
  description={`${fraseInstalacion.principal} ${fraseInstalacion.garantia} Cerraduras digitales, cerrojos, sobreponer, eléctricas y cajas fuertes de Yale, Schlage, Kwikset y más, en toda Bogotá.`}
  schema={schema}
>
  <section class="hero-ins con-fondo">
    <FondoVivo />
    <div class="container hero-grid">
      <div>
        <nav class="migas" aria-label="Ruta"><a href="/">Inicio</a><span>/</span><span aria-current="page">Cerraduras con instalación</span></nav>
        <h1>Cerraduras con instalación en <span>Bogotá</span></h1>
        <p class="frase">{fraseInstalacion.principal} <span>{fraseInstalacion.garantia}</span></p>
        <div class="actions">
          <a class="btn btn-accent btn-lg" href="/cerraduras">Ver las cerraduras<Icon name="flecha" /></a>
          <a class="btn btn-wa btn-lg" href={whatsapp('Hola Cerraya, quiero una cerradura con instalación')} target="_blank" rel="noopener"><Icon name="whatsapp" />Cotizar por WhatsApp</a>
        </div>
      </div>
      {fotoHero && (
        <figure class="hero-foto">
          <Image src={fotoHero} alt="Exhibidor de cerraduras Yale en el local de Cerraya" widths={[480, 800]} sizes="(max-width: 960px) 100vw, 40vw" loading="eager" />
        </figure>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Elige el tipo de cerradura</h2>
      <div class="grid grid-3 tipos">
        {tipos.map((t) => {
          const f = fotoTipo(t.slug);
          return (
            <a class="card tipo" href={`/cerraduras/${t.slug}`}>
              {f && <Image class="tipo-img" src={f} alt="" width={420} height={300} />}
              <div class="tipo-info">
                <h3>{t.nombre}</h3>
                <p>{t.resumen}</p>
                <span class="desde">Producto desde {pesos(rangoPrecios(t).desde)}</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section-cream">
    <div class="container">
      <h2>Algunas de las que instalamos</h2>
      <div class="productos">
        {destacados.map((p) => <ProductoCard producto={p!} />)}
      </div>
      <p class="marcas">Trabajamos {marcasDestacadas.join(', ')} y otras marcas reconocidas.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2 dos">
      <div>
        <h2>Cerraduras con instalación en tu localidad</h2>
        <ul class="chips enlaces">{localidadesBogota.map((l) => <li><a href={`/cerraduras-con-instalacion/${l.slug}`}>{l.nombre}</a></li>)}</ul>
      </div>
      <div>
        <h2>Preguntas frecuentes</h2>
        <Faq preguntas={preguntas} />
      </div>
    </div>
  </section>

  <CtaFinal titulo="¿Qué cerradura necesitas?" texto="Mándanos una foto de tu puerta por WhatsApp y te recomendamos la cerradura, con el valor instalada." />
</Base>

<style>
  .hero-ins { background: linear-gradient(180deg, var(--green-800), var(--green-900)); color: var(--on-green); padding: 2rem 0 clamp(2.5rem, 6vw, 4rem); }
  .hero-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .hero-ins h1 { color: var(--cream); }
  .hero-ins h1 span { color: var(--accent); }
  .frase { margin: .5rem 0 0; max-width: 30ch; font-family: var(--display); font-weight: 800; font-size: clamp(1.35rem, 2.8vw, 1.95rem); line-height: 1.25; color: var(--cream); }
  .frase span { display: block; margin-top: .4rem; color: var(--accent); }
  .hero-ins .actions { margin-top: 1.75rem; }
  .hero-foto { margin: 0; }
  .hero-foto :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); box-shadow: var(--shadow); }
  .migas { display: flex; flex-wrap: wrap; gap: .5rem; font-size: .88rem; color: var(--on-green-muted); margin-bottom: 1.25rem; }
  .migas a { color: var(--cream); }
  .tipo { padding: 0; overflow: hidden; text-decoration: none; display: flex; flex-direction: column; transition: border-color .18s, transform .18s; }
  .tipo:hover { border-color: var(--green-600); transform: translateY(-2px); }
  .tipo :global(.tipo-img) { width: 100%; height: auto; aspect-ratio: 7 / 5; object-fit: cover; }
  .tipo-info { padding: 1rem 1.15rem 1.2rem; display: flex; flex-direction: column; gap: .35rem; flex: 1; }
  .tipo-info h3 { margin: 0; font-size: 1.1rem; }
  .tipo-info p { margin: 0; color: var(--muted); font-size: .92rem; }
  .desde { margin-top: auto; padding-top: .4rem; font-family: var(--display); font-weight: 800; color: var(--green-600); }
  .productos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 1.25rem; }
  .marcas { margin-top: 1.25rem; color: var(--muted); font-size: .93rem; }
  .dos { align-items: start; gap: 2.5rem; }
  .enlaces a { text-decoration: none; color: var(--green-800); font-weight: 600; }
  @media (max-width: 1080px) { .productos { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 960px) { .hero-grid { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .productos { grid-template-columns: repeat(2, 1fr); gap: .7rem; } }
</style>
