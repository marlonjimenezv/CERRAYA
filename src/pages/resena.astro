---
import Base from '../layouts/Base.astro';
import FondoVivo from '../components/FondoVivo.astro';
import Logo from '../components/Logo.astro';
import { empresa, whatsapp } from '../data/empresa';

// cerraya.com/resena: el cerrajero muestra este enlace (o su QR) al terminar cada servicio.
---
<Base title="Califica tu servicio" description="Gracias por confiar en Cerraya. Cuéntanos cómo te fue." noindex sinMarco>
  <section class="resena con-fondo">
    <FondoVivo />
    <div class="narrow resena-box">
      <a href="/" class="resena-logo" aria-label="Cerraya, inicio"><Logo /></a>
      <h1>Gracias por <span>confiar en nosotros</span></h1>
      <p class="lead">Tu opinión le ayuda a otra persona en Bogotá a encontrar un cerrajero honesto. Toma menos de un minuto.</p>
      <a class="btn btn-accent btn-lg" href={empresa.enlaceResenaGoogle} target="_blank" rel="noopener"><span aria-hidden="true">★★★★★</span>Calificar en Google</a>
      <p class="nota">¿Algo no salió como esperabas? <a href={whatsapp('Hola Cerraya, quiero comentarles sobre mi servicio')} target="_blank" rel="noopener">Escríbenos por WhatsApp</a> y lo resolvemos.</p>
    </div>
  </section>
</Base>

<style>
  .resena { min-height: 100vh; display: grid; place-items: center; padding: 3rem 0; background: linear-gradient(180deg, var(--green-800), var(--green-900)); color: var(--on-green); text-align: center; }
  .resena-box { display: grid; justify-items: center; }
  .resena-logo { color: var(--cream); text-decoration: none; font-size: 1.4rem; margin-bottom: 2.5rem; }
  .resena h1 { color: var(--cream); margin-inline: auto; }
  .resena h1 span { color: var(--accent); display: block; }
  .resena .lead { color: var(--on-green-muted); margin: 0 auto 2rem; }
  .nota { margin-top: 1.5rem; font-size: .93rem; color: var(--on-green-muted); }
  .nota a { color: var(--cream); }
</style>
