---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { tel, whatsapp } from '../../data/empresa';

// Páginas de éxito de los formularios de Netlify. Aquí se registra la conversión "formulario".
export function getStaticPaths() {
  return [
    {
      params: { tipo: 'cotizacion' },
      props: {
        titulo: '¡Recibimos tu solicitud!',
        texto: 'En minutos te enviamos tu cotización por WhatsApp. Si es una urgencia, no esperes: llámanos.',
      },
    },
    {
      params: { tipo: 'pregunta' },
      props: {
        titulo: '¡Gracias por tu pregunta!',
        texto: 'La revisamos y, si nos dejaste tu contacto, te avisamos cuando la publiquemos en Consejos. Si es una urgencia, llámanos.',
      },
    },
    {
      params: { tipo: 'aliados' },
      props: {
        titulo: '¡Gracias por postularte!',
        texto: 'Revisamos cada postulación con cuidado. Si tu perfil encaja con la red Cerraya te contactamos para una entrevista y una prueba técnica.',
      },
    },
  ];
}

const { tipo } = Astro.params;
const { titulo, texto } = Astro.props;
---
<Base title={titulo} description="Gracias por escribir a Cerraya." noindex>
  <section class="section">
    <div class="narrow gracias" data-formulario={tipo}>
      <span class="ok"><Icon name="check" /></span>
      <h1>{titulo}</h1>
      <p class="lead">{texto}</p>
      <div class="actions">
        <a class="btn btn-accent btn-lg" href={tel}><Icon name="telefono" />Llamar ahora</a>
        <a class="btn btn-outline btn-lg" href="/">Volver al inicio</a>
      </div>
      <p class="muted-small">¿Quieres adelantar por chat? <a href={whatsapp('Hola Cerraya, acabo de enviar el formulario de la página')} target="_blank" rel="noopener">Escríbenos por WhatsApp</a></p>
    </div>
  </section>
</Base>

<script>
  import { registrar } from '../../scripts/medicion';
  const formulario = document.querySelector<HTMLElement>('[data-formulario]')?.dataset.formulario;
  registrar('formulario', formulario);
</script>

<style>
  .gracias { text-align: center; }
  .gracias .lead, .gracias h1 { margin-inline: auto; }
  .gracias .actions { justify-content: center; margin-top: 1.5rem; }
  .ok { display: inline-grid; place-items: center; width: 72px; height: 72px; border-radius: 50%; background: var(--green-800); color: var(--cream); margin-bottom: 1.5rem; }
  .ok :global(svg) { width: 36px; height: 36px; }
  .muted-small { margin-top: 1.5rem; color: var(--muted); font-size: .95rem; }
</style>
