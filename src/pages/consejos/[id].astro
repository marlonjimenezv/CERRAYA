---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { empresa, tel, whatsapp } from '../../data/empresa';

export async function getStaticPaths() {
  const consejos = await getCollection('consejos');
  return consejos.map((consejo) => ({ params: { id: consejo.id }, props: { consejo } }));
}

const { consejo } = Astro.props as { consejo: CollectionEntry<'consejos'> };
const { Content } = await render(consejo);
const otros = (await getCollection('consejos')).filter((c) => c.id !== consejo.id).slice(0, 3);
const fecha = consejo.data.fecha.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: consejo.data.titulo,
  description: consejo.data.descripcion,
  datePublished: consejo.data.fecha.toISOString().slice(0, 10),
  author: { '@type': 'Organization', name: empresa.nombre, url: empresa.sitio },
  publisher: { '@type': 'Organization', name: empresa.nombre, logo: { '@type': 'ImageObject', url: `${empresa.sitio}/img/logo-cerraya.png` } },
  mainEntityOfPage: `${empresa.sitio}/consejos/${consejo.id}`,
};
---
<Base title={consejo.data.titulo} description={consejo.data.descripcion} schema={schema}>
  <article>
    <header class="art-hero">
      <div class="narrow">
        <nav class="migas" aria-label="Ruta"><a href="/">Inicio</a><span>/</span><a href="/consejos">Consejos</a></nav>
        <span class="eyebrow">{consejo.data.categoria}</span>
        <h1>{consejo.data.titulo}</h1>
        <p class="lead">{consejo.data.descripcion}</p>
        <p class="autor">Por el equipo Cerraya · {fecha}</p>
      </div>
    </header>

    {consejo.data.imagen && (
      <div class="narrow art-img">
        <Image src={consejo.data.imagen} alt="" widths={[700, 1100]} sizes="(max-width: 800px) 100vw, 780px" loading="eager" />
      </div>
    )}

    <div class="narrow prosa">
      <Content />
    </div>
  </article>

  <aside class="narrow ayuda card">
    <div>
      <h2>¿Necesitas un cerrajero?</h2>
      <p>Cerrajeros con más de {empresa.experiencia} años de experiencia. Urgencias 24/7 en Bogotá.</p>
    </div>
    <div class="actions">
      <a class="btn btn-accent" href={tel}><Icon name="telefono" />Llamar</a>
      <a class="btn btn-wa" href={whatsapp()} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
    </div>
  </aside>

  {otros.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Sigue leyendo</span>
          <h2>Más consejos</h2>
        </div>
        <div class="grid grid-3">
          {otros.map((c) => (
            <a class="card otro" href={`/consejos/${c.id}`}>
              <span class="cat">{c.data.categoria}</span>
              <h3>{c.data.titulo}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .art-hero { background: var(--cream); padding: 2rem 0 2.5rem; }
  .migas { display: flex; gap: .5rem; font-size: .88rem; color: var(--muted); margin-bottom: 1.25rem; }
  .migas a { color: var(--green-600); }
  .art-hero h1 { font-size: clamp(1.9rem, 4.5vw, 2.8rem); max-width: 26ch; }
  .autor { font-size: .88rem; color: var(--muted); margin: 0; }
  .art-img { margin-top: -1rem; }
  .art-img :global(img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); box-shadow: var(--shadow); }
  .prosa { padding: 2.5rem 0 1rem; font-size: 1.06rem; line-height: 1.75; }
  .prosa :global(h2) { font-size: 1.45rem; margin: 2.2rem 0 .7rem; }
  .prosa :global(h3) { font-size: 1.15rem; margin: 1.6rem 0 .5rem; }
  .prosa :global(a) { color: var(--green-600); font-weight: 600; }
  .prosa :global(ul), .prosa :global(ol) { padding-left: 1.3rem; }
  .prosa :global(li) { margin: .35rem 0; }
  .prosa :global(li::marker) { color: var(--green-600); }
  .prosa :global(strong) { color: var(--ink); }
  .prosa :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2.5rem 0 1.5rem; }
  .prosa :global(table) { margin: 1.25rem 0; border: 1px solid var(--line); border-radius: var(--radius-sm); overflow: hidden; display: block; overflow-x: auto; }
  .ayuda { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; background: var(--green-800); border-color: transparent; color: var(--on-green); margin-block: 1rem 3rem; }
  .ayuda h2 { color: var(--cream); font-size: 1.3rem; margin-bottom: .3rem; }
  .ayuda p { margin: 0; color: var(--on-green-muted); }
  .cat { font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--green-600); }
  .otro { text-decoration: none; display: grid; gap: .4rem; transition: border-color .18s, transform .18s; }
  .otro:hover { border-color: var(--green-600); transform: translateY(-2px); }
  .otro h3 { margin: 0; font-size: 1.05rem; }
</style>
