---
// Barra de reseñas de Google que se desliza sola. Se pausa al pasar el mouse o al tocarla,
// y sin animación para quien pidió movimiento reducido (ahí se desplaza con el dedo).
import { empresa } from '../data/empresa';
import { resenas } from '../data/resenas';

interface Props {
  tono?: 'claro' | 'oscuro';
}
const { tono = 'claro' } = Astro.props;
const duracion = `${resenas.length * 3.5}s`;
---
<section class:list={['resenas-barra', tono]} aria-label="Reseñas de clientes en Google: 5 estrellas">
  <div class="container barra-head">
    <a class="barra-score" href={empresa.enlacePerfilGoogle} target="_blank" rel="noopener">
      <strong>{empresa.resenas.calificacion}</strong>
      <span class="stars" aria-hidden="true">★★★★★</span>
      <span>en Google</span>
    </a>
    <a class="barra-ver" href={empresa.enlacePerfilGoogle} target="_blank" rel="noopener">Ver todas en Google →</a>
  </div>
  <div class="pista" tabindex="0">
    <ul class="cinta" style={`--dur: ${duracion}`}>
      {[...resenas, ...resenas].map((r, i) => (
        <li class="resena" aria-hidden={i >= resenas.length ? 'true' : undefined}>
          <span class="stars" aria-hidden="true">★★★★★</span>
          <p>“{r.texto}”</p>
          <span class="autor">{r.nombre} <small>· Google</small></span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .resenas-barra { padding: 1.5rem 0 1.75rem; background: var(--cream-2); border-bottom: 1px solid var(--line); overflow: hidden; }
  .resenas-barra.oscuro { background: var(--green-900); border-color: rgba(247, 245, 232, .1); }
  .barra-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .barra-score { display: inline-flex; align-items: baseline; gap: .55rem; text-decoration: none; color: var(--ink); font-size: .95rem; }
  .barra-score strong { font-family: var(--display); font-size: 1.6rem; font-weight: 800; color: var(--green-800); }
  .barra-score .stars, .resena .stars { color: #f2b33d; letter-spacing: .05em; }
  .barra-ver { font-weight: 700; font-size: .9rem; color: var(--green-600); text-decoration: none; }
  .oscuro .barra-score { color: var(--cream); }
  .oscuro .barra-score strong { color: var(--cream); }
  .oscuro .barra-ver { color: var(--accent); }

  .pista { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent); }
  .cinta { list-style: none; margin: 0; padding: 0 0 .25rem; display: flex; gap: 1rem; width: max-content; animation: deslizar var(--dur, 160s) linear infinite; }
  .pista:hover .cinta, .pista:focus-within .cinta, .pista:active .cinta { animation-play-state: paused; }
  @keyframes deslizar { to { transform: translateX(-50%); } }

  .resena { flex: none; width: 300px; display: flex; flex-direction: column; gap: .5rem; padding: 1rem 1.15rem; border-radius: var(--radius-sm); background: var(--white); border: 1px solid var(--line); }
  .resena p { margin: 0; font-size: .93rem; line-height: 1.45; color: var(--ink); display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .autor { margin-top: auto; font-weight: 700; font-size: .88rem; color: var(--green-800); }
  .autor small { font-weight: 500; color: var(--muted); }
  .oscuro .resena { background: rgba(247, 245, 232, .06); border-color: rgba(247, 245, 232, .14); }
  .oscuro .resena p { color: var(--cream); }
  .oscuro .autor { color: var(--cream); }
  .oscuro .autor small { color: var(--on-green-muted); }

  @media (max-width: 520px) { .resena { width: 260px; } }
  @media (prefers-reduced-motion: reduce) {
    .cinta { animation: none; }
    .pista { overflow-x: auto; scroll-snap-type: x mandatory; mask-image: none; }
    .resena { scroll-snap-align: start; }
    .resena[aria-hidden='true'] { display: none; }
  }
</style>
