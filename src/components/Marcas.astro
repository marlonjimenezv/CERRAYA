---
// Marcas que confiaron en nosotros: logos de empresas y nombres de conjuntos residenciales.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { marcas } from '../data/marcas';
---
<section class="section marcas" aria-labelledby="marcas-titulo">
  <div class="container">
    <h2 id="marcas-titulo">Marcas que confiaron en nosotros</h2>
    <ul class="marcas-grid">
      {marcas.map((m) => (
        <li class:list={['marca', `marca-${m.tipo}`]}>
          {m.logo ? (
            <Image src={m.logo} alt={m.nombre} width={Math.min(m.logo.width, 360)} loading="lazy" />
          ) : m.tipo === 'conjunto' ? (
            <span class="marca-nombre">
              <Icon name="edificio" />
              <span><small>Conjunto residencial</small><strong>{m.nombre}</strong></span>
            </span>
          ) : (
            <span class="marca-nombre"><strong>{m.nombre}</strong></span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .marcas { padding: clamp(2.75rem, 6vw, 4rem) 0; background: var(--white); border-bottom: 1px solid var(--line); }
  .marcas h2 { text-align: center; margin: 0 auto 1.75rem; max-width: none; font-size: clamp(1.35rem, 2.6vw, 1.9rem); }
  .marcas-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .85rem; }
  .marca { display: grid; place-items: center; min-height: 104px; padding: 1rem 1.1rem; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-sm); }
  .marca img { display: block; width: auto; height: auto; max-width: 100%; max-height: 54px; object-fit: contain; }
  .marca-nombre { display: flex; align-items: center; gap: .6rem; text-align: left; line-height: 1.15; }
  .marca-nombre strong { display: block; font-family: var(--display); font-weight: 800; font-size: 1.05rem; color: var(--green-800); letter-spacing: -.01em; }
  .marca-empresa .marca-nombre strong { font-size: 1.2rem; text-align: center; }
  .marca-nombre small { display: block; font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-bottom: .15rem; }
  .marca-nombre :global(svg) { flex: none; width: 34px; height: 34px; padding: 7px; border-radius: 50%; background: var(--cream-2); color: var(--green-700, var(--green-800)); }

  @media (max-width: 960px) {
    .marcas-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .marcas-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem; }
    .marca { min-height: 88px; padding: .8rem; }
    .marca img { max-height: 44px; }
    .marca-nombre strong { font-size: .95rem; }
    .marca-empresa .marca-nombre strong { font-size: 1.05rem; }
    .marca-nombre :global(svg) { width: 28px; height: 28px; padding: 6px; }
  }
</style>
