---
import { iconos, type NombreIcono } from './iconos';

interface Props {
  name: NombreIcono;
  class?: string;
}

const { name, class: clase = '' } = Astro.props;
---
<svg
  class:list={['icon', clase]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={iconos[name]}
/>
