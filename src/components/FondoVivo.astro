---
// Fondo animado de los encabezados verdes: el dial de una caja fuerte que marca una combinación
// de tres números; al completarla, el candado del logo (en el centro) se abre con un brillo dorado.
// Se mueve levemente con el cursor, se pausa fuera de pantalla y respeta "reducir movimiento".
---
<div class="fondo-vivo" aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .fondo-vivo { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .fondo-vivo canvas { display: block; width: 100%; height: 100%; }
  .fondo-vivo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(6, 42, 32, .8) 0%, rgba(6, 42, 32, .35) 40%, transparent 65%),
      linear-gradient(180deg, transparent 60%, rgba(4, 32, 26, .5) 100%);
  }
</style>

<script>
  const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const CREMA = '247,245,232';
  const ACENTO = '242,179,61';
  const N = 100;
  const ARCO = new Path2D('M53 153V111a93 93 0 0 1 186 0v42');
  const CUERPO = new Path2D('M14 153h264a14 14 0 0 1 14 14v174a44 44 0 0 1-44 44H44A44 44 0 0 1 0 341V167a14 14 0 0 1 14-14zM114 336l14.7-67.3a37 37 0 1 1 34.6 0L178 336z');
  const suave = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);

  document.querySelectorAll<HTMLElement>('.fondo-vivo').forEach((cont) => {
    const canvas = cont.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const seccion = cont.parentElement!;
    let ancho = 0, alto = 0, cx = 0, cy = 0, radio = 0;
    let visible = true, raf = 0, ultimo = 0;
    let cursor = { x: 0, y: 0 };
    const parallax = { x: 0, y: 0 };

    // Estado de la combinación
    let giro = 0; // rotación actual del dial, en números (0-100)
    let combinacion = [25, 10, 40];
    let paso = 0, desde = 0, hasta = 0, tPaso = 0, durPaso = 1.6, pausa = 0.6;
    let abierto = 0, tFase = 0;
    let fase: 'marcando' | 'abriendo' | 'abierto' | 'cerrando' = 'marcando';

    function nuevaCombinacion() {
      combinacion = [0, 0, 0].map(() => Math.floor(5 + Math.random() * 90));
      paso = 0;
    }

    function prepararPaso() {
      desde = giro;
      // Se alterna el sentido como en una caja fuerte real: derecha, izquierda, derecha
      const horario = paso % 2 === 0;
      let delta = (((combinacion[paso] - giro) % N) + N) % N;
      if (!horario) delta -= N;
      if (Math.abs(delta) < 30) delta += horario ? N : -N;
      hasta = giro + delta;
      durPaso = 1.4 + Math.abs(delta) / 90;
      tPaso = 0;
    }

    function preparar() {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      ancho = cont.clientWidth;
      alto = cont.clientHeight;
      canvas.width = Math.round(ancho * dpr);
      canvas.height = Math.round(alto * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // En pantallas de una sola columna el dial va pequeño en la esquina para no tapar el texto.
      const angosto = ancho < 1000;
      radio = angosto ? Math.min(ancho * 0.36, alto * 0.24, 260) : Math.min(alto * 0.62, ancho * 0.34);
      cx = angosto ? ancho - radio * 0.55 : ancho * 0.8;
      cy = angosto ? radio * 1.35 : alto * 0.52;
    }

    function dibujar() {
      ctx.clearRect(0, 0, ancho, alto);
      const r = radio;
      const rot = (giro / N) * Math.PI * 2;
      const x = cx + parallax.x, y = cy + parallax.y;

      // Halo
      const halo = ctx.createRadialGradient(x, y, r * 0.2, x, y, r * 1.35);
      halo.addColorStop(0, `rgba(${ACENTO},${0.05 + abierto * 0.1})`);
      halo.addColorStop(1, `rgba(${ACENTO},0)`);
      ctx.fillStyle = halo;
      ctx.fillRect(0, 0, ancho, alto);

      ctx.save();
      ctx.translate(x, y);

      // Aros fijos
      ctx.lineWidth = 1;
      ctx.strokeStyle = `rgba(${CREMA},0.09)`;
      for (const f of [1.08, 1, 0.62, 0.5]) {
        ctx.beginPath();
        ctx.arc(0, 0, r * f, 0, Math.PI * 2);
        ctx.stroke();
      }

      // Dial que gira
      ctx.save();
      ctx.rotate(-rot);
      ctx.strokeStyle = `rgba(${CREMA},0.06)`;
      for (let i = 0; i < 180; i++) {
        const a = (i / 180) * Math.PI * 2;
        ctx.beginPath();
        ctx.moveTo(Math.cos(a) * r, Math.sin(a) * r);
        ctx.lineTo(Math.cos(a) * r * 1.07, Math.sin(a) * r * 1.07);
        ctx.stroke();
      }
      ctx.font = `600 ${Math.max(11, r * 0.07)}px "Montserrat Variable", Montserrat, sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      for (let n = 0; n < N; n++) {
        const a = (n / N) * Math.PI * 2 - Math.PI / 2;
        const mayor = n % 10 === 0, media = n % 5 === 0;
        const largo = mayor ? 0.12 : media ? 0.08 : 0.045;
        ctx.strokeStyle = `rgba(${CREMA},${mayor ? 0.28 : 0.13})`;
        ctx.lineWidth = mayor ? 2 : 1;
        ctx.beginPath();
        ctx.moveTo(Math.cos(a) * r * 0.98, Math.sin(a) * r * 0.98);
        ctx.lineTo(Math.cos(a) * r * (0.98 - largo), Math.sin(a) * r * (0.98 - largo));
        ctx.stroke();
        if (mayor) {
          ctx.fillStyle = `rgba(${CREMA},0.2)`;
          ctx.save();
          ctx.translate(Math.cos(a) * r * 0.76, Math.sin(a) * r * 0.76);
          ctx.rotate(a + Math.PI / 2);
          ctx.fillText(String(n), 0, 0);
          ctx.restore();
        }
      }
      ctx.restore();

      // Indicador fijo arriba
      ctx.fillStyle = `rgba(${ACENTO},0.75)`;
      ctx.beginPath();
      ctx.moveTo(0, -r * 1.1);
      ctx.lineTo(-r * 0.035, -r * 1.19);
      ctx.lineTo(r * 0.035, -r * 1.19);
      ctx.closePath();
      ctx.fill();

      // Puntos de la combinación ya acertados
      const acertados = fase === 'marcando' ? paso : 3;
      for (let i = 0; i < 3; i++) {
        ctx.fillStyle = i < acertados ? `rgba(${ACENTO},0.8)` : `rgba(${CREMA},0.15)`;
        ctx.beginPath();
        ctx.arc((i - 1) * r * 0.07, -r * 1.27, r * 0.016, 0, Math.PI * 2);
        ctx.fill();
      }

      // Candado del logo en el centro: se abre al completar la combinación
      const escala = (r * 0.5) / 385;
      const color = abierto > 0.02 ? ACENTO : CREMA;
      const alfa = 0.09 + abierto * 0.38;
      ctx.save();
      ctx.scale(escala, escala);
      ctx.translate(-146, -200);
      ctx.shadowColor = `rgba(${ACENTO},${0.7 * abierto})`;
      ctx.shadowBlur = 40 * abierto;
      ctx.fillStyle = `rgba(${color},${alfa})`;
      ctx.fill(CUERPO, 'evenodd');
      ctx.translate(0, -70 * abierto);
      ctx.strokeStyle = `rgba(${color},${alfa})`;
      ctx.lineWidth = 36;
      ctx.stroke(ARCO);
      ctx.restore();

      ctx.restore();
    }

    function avanzar(dt: number) {
      parallax.x += (cursor.x - parallax.x) * Math.min(1, dt * 3);
      parallax.y += (cursor.y - parallax.y) * Math.min(1, dt * 3);
      tFase += dt;
      if (fase === 'marcando') {
        if (pausa > 0) {
          pausa -= dt;
          return;
        }
        tPaso += dt;
        const p = Math.min(1, tPaso / durPaso);
        giro = desde + (hasta - desde) * suave(p);
        if (p >= 1) {
          giro = ((hasta % N) + N) % N;
          paso++;
          pausa = 0.45;
          if (paso >= 3) {
            fase = 'abriendo';
            tFase = 0;
          } else prepararPaso();
        }
      } else if (fase === 'abriendo') {
        abierto = suave(Math.min(1, tFase / 0.6));
        if (tFase >= 0.6) { fase = 'abierto'; tFase = 0; }
      } else if (fase === 'abierto') {
        if (tFase >= 1.6) { fase = 'cerrando'; tFase = 0; }
      } else {
        abierto = 1 - suave(Math.min(1, tFase / 0.6));
        if (tFase >= 0.6) {
          fase = 'marcando';
          nuevaCombinacion();
          prepararPaso();
          pausa = 1.2;
        }
      }
    }

    function cuadro(ahora: number) {
      const dt = Math.min(0.05, (ahora - ultimo) / 1000 || 0.016);
      ultimo = ahora;
      avanzar(dt);
      dibujar();
      if (visible && !document.hidden) raf = requestAnimationFrame(cuadro);
    }

    function arrancar() {
      cancelAnimationFrame(raf);
      ultimo = performance.now();
      raf = requestAnimationFrame(cuadro);
    }

    preparar();
    prepararPaso();

    if (reducir) {
      giro = 25;
      dibujar();
      document.fonts?.ready.then(dibujar);
      new ResizeObserver(() => { preparar(); dibujar(); }).observe(cont);
      return;
    }

    new ResizeObserver(preparar).observe(cont);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) arrancar();
    }).observe(cont);
    document.addEventListener('visibilitychange', () => !document.hidden && visible && arrancar());
    seccion.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const b = cont.getBoundingClientRect();
      cursor = { x: ((e.clientX - b.left) / b.width - 0.5) * 30, y: ((e.clientY - b.top) / b.height - 0.5) * 30 };
    });
    seccion.addEventListener('pointerleave', () => (cursor = { x: 0, y: 0 }));
    arrancar();
  });
</script>
