---
// Candado del logo de Cerraya redibujado en vector, con el ojo de la cerradura calado.
interface Props {
  conTexto?: boolean;
  class?: string;
}
const { conTexto = true, class: clase = '' } = Astro.props;
---
<span class:list={['logo', clase]}>
  <svg class="logo-icon" viewBox="0 0 292 385" aria-hidden="true">
    <path d="M53 153V111a93 93 0 0 1 186 0v42" fill="none" stroke="currentColor" stroke-width="36" />
    <path
      fill="currentColor"
      fill-rule="evenodd"
      d="M14 153h264a14 14 0 0 1 14 14v174a44 44 0 0 1-44 44H44A44 44 0 0 1 0 341V167a14 14 0 0 1 14-14zM114 336l14.7-67.3a37 37 0 1 1 34.6 0L178 336z"
    />
  </svg>
  {conTexto && <span class="logo-text">CERRAYA</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: .55em; color: inherit; }
  .logo-icon { width: auto; height: 1.55em; flex: none; }
  .logo-text { font-family: var(--display); font-weight: 800; font-size: 1.25em; letter-spacing: .04em; line-height: 1; }
</style>
