---
// Ilustraciones propias de cada tipo de cerradura, en los colores de la marca.
// Se usan mientras un producto no tenga foto real.
interface Props {
  tipo: string;
  class?: string;
}
const { tipo, class: clase = '' } = Astro.props;
---
<svg class:list={['ilu', clase]} viewBox="0 0 240 180" role="img" aria-label="Ilustración de la cerradura">
  {tipo === 'digitales' && (
    <g>
      <rect class="sombra" x="78" y="152" width="84" height="8" rx="4" />
      <rect class="v8" x="82" y="18" width="76" height="134" rx="16" />
      <rect class="v7" x="92" y="30" width="56" height="20" rx="5" />
      <rect class="acento" x="100" y="37" width="22" height="6" rx="3" />
      {[0, 1, 2].map((f) => [0, 1, 2].map((c) => <circle class="crema" cx={104 + c * 16} cy={66 + f * 15} r="4.5" />))}
      <circle class="anillo" cx="120" cy="126" r="12" />
      <path class="huella" d="M114 126a6 6 0 0 1 12 0M117 129a3 3 0 0 1 6 0v3" />
      <rect class="metal" x="150" y="94" width="58" height="13" rx="6.5" />
    </g>
  )}
  {tipo === 'cerrojos' && (
    <g>
      <rect class="sombra" x="72" y="150" width="96" height="8" rx="4" />
      <rect class="metal" x="140" y="78" width="72" height="24" rx="4" />
      <circle class="v8" cx="112" cy="90" r="56" />
      <circle class="v7" cx="112" cy="90" r="38" />
      <circle class="crema" cx="112" cy="90" r="20" />
      <rect class="v8" x="108" y="76" width="8" height="22" rx="3" />
      <circle class="acento" cx="112" cy="104" r="4" />
    </g>
  )}
  {tipo === 'sobreponer' && (
    <g>
      <rect class="sombra" x="44" y="146" width="152" height="8" rx="4" />
      <rect class="metal" x="186" y="76" width="26" height="28" rx="3" />
      <rect class="v8" x="40" y="44" width="152" height="96" rx="12" />
      <rect class="v7" x="52" y="56" width="128" height="72" rx="8" />
      <circle class="crema" cx="92" cy="92" r="20" />
      <rect class="v8" x="80" y="88" width="24" height="8" rx="4" />
      <circle class="acento" cx="152" cy="92" r="12" />
      <rect class="v8" x="149.5" y="84" width="5" height="16" rx="2.5" />
    </g>
  )}
  {tipo === 'embutir' && (
    <g>
      <rect class="sombra" x="82" y="162" width="76" height="8" rx="4" />
      <rect class="v8" x="92" y="12" width="44" height="150" rx="22" />
      <circle class="metal-c" cx="114" cy="56" r="13" />
      <rect class="metal" x="110" y="48" width="96" height="16" rx="8" />
      <circle class="acento" cx="114" cy="118" r="11" />
      <rect class="v8" x="111.5" y="110" width="5" height="16" rx="2.5" />
      {[34, 88, 142].map((y) => <rect class="acento" x="76" y={y - 4} width="18" height="8" rx="3" />)}
    </g>
  )}
  {tipo === 'manija-y-pomo' && (
    <g>
      <rect class="sombra" x="54" y="140" width="80" height="8" rx="4" />
      <circle class="v8" cx="92" cy="90" r="40" />
      <circle class="v7" cx="92" cy="90" r="26" />
      <rect class="metal" x="88" y="78" width="118" height="24" rx="12" />
      <circle class="metal-c" cx="92" cy="90" r="18" />
      <circle class="acento" cx="92" cy="90" r="6" />
    </g>
  )}
  {tipo === 'electricas' && (
    <g>
      <rect class="sombra" x="56" y="142" width="128" height="8" rx="4" />
      <path class="cable" d="M92 138v24M108 138v24" />
      <rect class="metal" x="176" y="74" width="34" height="26" rx="3" />
      <rect class="v8" x="52" y="34" width="132" height="104" rx="12" />
      <rect class="v7" x="64" y="46" width="108" height="80" rx="8" />
      <path class="acento" d="M126 54l-30 40h20l-6 26 30-40h-20z" />
    </g>
  )}
  {tipo === 'cajas-fuertes' && (
    <g>
      <rect class="v8" x="58" y="150" width="20" height="14" rx="3" />
      <rect class="v8" x="162" y="150" width="20" height="14" rx="3" />
      <rect class="v8" x="48" y="18" width="144" height="136" rx="14" />
      <rect class="v7" x="60" y="30" width="120" height="112" rx="9" />
      <circle class="crema" cx="112" cy="86" r="28" />
      <circle class="v8" cx="112" cy="86" r="9" />
      {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => (
        <rect class="v8" x="111" y="60" width="2" height="7" rx="1" transform={`rotate(${a} 112 86)`} />
      ))}
      <rect class="acento" x="156" y="66" width="10" height="40" rx="5" />
    </g>
  )}
  {tipo === 'candados' && (
    <g>
      <rect class="sombra" x="70" y="158" width="100" height="8" rx="4" />
      <path class="arco" d="M88 86V64a32 32 0 0 1 64 0v22" />
      <path class="v8" d="M74 86h92a10 10 0 0 1 10 10v44a20 20 0 0 1-20 20H84a20 20 0 0 1-20-20V96a10 10 0 0 1 10-10z" />
      <circle class="crema" cx="120" cy="114" r="11" />
      <path class="crema" d="M114 120h12l4 22h-20z" />
    </g>
  )}
  {tipo === 'muebles' && (
    <g>
      <rect class="sombra" x="34" y="146" width="172" height="8" rx="4" />
      <rect class="v8" x="30" y="40" width="180" height="104" rx="10" />
      <rect class="v7" x="42" y="52" width="156" height="80" rx="6" />
      <rect class="metal" x="80" y="84" width="54" height="12" rx="6" />
      <circle class="crema" cx="168" cy="90" r="14" />
      <rect class="v8" x="165.5" y="82" width="5" height="16" rx="2.5" />
    </g>
  )}
</svg>

<style>
  .ilu { width: 100%; height: auto; display: block; }
  .v8 { fill: var(--green-800); }
  .v7 { fill: var(--green-700); }
  .crema { fill: var(--cream); }
  .acento { fill: var(--accent); }
  .metal { fill: #d9dccf; stroke: #b7bcad; stroke-width: 1.5; }
  .metal-c { fill: #e4e6da; stroke: #b7bcad; stroke-width: 1.5; }
  .sombra { fill: rgba(6, 42, 32, .12); }
  .anillo { fill: none; stroke: var(--accent); stroke-width: 3; }
  .huella { fill: none; stroke: var(--cream); stroke-width: 2; stroke-linecap: round; }
  .arco { fill: none; stroke: var(--green-600); stroke-width: 16; }
  .cable { fill: none; stroke: var(--green-600); stroke-width: 4; stroke-linecap: round; }
</style>
