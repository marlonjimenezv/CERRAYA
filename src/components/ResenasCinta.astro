---
// Cinta delgada de reseñas de Google justo debajo del menú, en todas las páginas.
// Pasan TODAS las reseñas, una detrás de otra. Se pausa al pasar el mouse o tocarla.
// Sin animación para quien pidió movimiento reducido (ahí se desplaza con el dedo).
import { empresa } from '../data/empresa';
import { resenas } from '../data/resenas';

const duracion = `${resenas.length * 7}s`;
---
<div class="cinta-resenas" aria-label="Opiniones de clientes en Google: 5 estrellas">
  <a class="sello" href={empresa.enlacePerfilGoogle} target="_blank" rel="noopener">
    <span class="estrellas" aria-hidden="true">★★★★★</span>
    <span class="sello-txt">en Google</span>
  </a>
  <div class="riel" tabindex="0">
    <ul class="pasan" style={`--dur: ${duracion}`}>
      {[...resenas, ...resenas].map((r, i) => (
        <li aria-hidden={i >= resenas.length ? 'true' : undefined}>
          <span class="estrellas" aria-hidden="true">★★★★★</span>
          <q>{r.texto}</q>
          <span class="quien">{r.nombre}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .cinta-resenas { display: flex; align-items: stretch; background: var(--cream-2); border-bottom: 1px solid var(--line); font-size: 1.05rem; overflow: hidden; }
  .sello { flex: none; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: .1rem; padding: .75rem 1.5rem; background: var(--accent); color: var(--accent-ink); text-decoration: none; font-family: var(--display); font-weight: 800; line-height: 1.1; z-index: 1; }
  .sello .estrellas { font-size: 1.2rem; letter-spacing: .06em; color: var(--accent-ink); }
  .sello-txt { font-size: .85rem; }
  .riel { flex: 1; overflow: hidden; display: flex; align-items: center; mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent); }
  .pasan { list-style: none; margin: 0; padding: .7rem 0; display: flex; gap: .85rem; width: max-content; animation: pasar var(--dur, 300s) linear infinite; }
  .riel:hover .pasan, .riel:focus-within .pasan, .riel:active .pasan { animation-play-state: paused; }
  @keyframes pasar { to { transform: translateX(calc(-50% - .425rem)); } }
  .pasan li { display: flex; align-items: center; gap: .6rem; padding: .6rem 1.1rem; white-space: nowrap; background: var(--white); border: 1px solid var(--line); border-radius: 999px; box-shadow: 0 1px 2px rgba(6, 42, 32, .06); }
  .pasan .estrellas { color: #e0a22f; font-size: 1rem; letter-spacing: .04em; }
  .pasan q { color: var(--ink); quotes: '“' '”'; }
  .quien { font-weight: 700; color: var(--green-800); }
  @media (max-width: 560px) {
    .cinta-resenas { font-size: .95rem; }
    .sello { padding: .6rem .85rem; }
    .sello-txt { font-size: .72rem; }
    .sello .estrellas { font-size: .95rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pasan { animation: none; }
    .riel { overflow-x: auto; mask-image: none; }
    .pasan li[aria-hidden='true'] { display: none; }
  }
</style>
